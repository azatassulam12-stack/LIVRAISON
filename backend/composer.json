{
  "name": "nex-gen/livraison-api",
  "description": "API centrale de la plateforme NEX-GEN LIVRAISON",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "App\\": "app/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "test": ["@php artisan test"],
    "lint": ["@php vendor/bin/pint --test"]
  },
  "config": { "sort-packages": true, "optimize-autoloader": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
